# =============================================================================
# CIRKLE search engine — environment variable template
# =============================================================================
# Copy this file to `.env` and fill in the values you need.
#
#   cp .env.example .env
#
# Only DATABASE_URL is required to boot the app. Everything else is optional —
# the engine runs in a fully-functional "free stack" mode without BrightData
# or any paid API key.
#
# Each variable below has a one-line comment explaining what it does.
# =============================================================================

# --- Required: database connection -------------------------------------------
# SQLite path (default, dev-friendly, no external service needed).
# The path can be absolute (recommended) or relative to the project root.
DATABASE_URL=file:/home/z/my-project/db/custom.db

# --- BrightData (optional but recommended for premium scraping tier) --------
# BrightData API bearer token. Enables the BrightData datasets v3 API +
# Scraping Browser. If unset, the engine runs in "shadow mode" — every
# BrightData function returns null and the engine uses the free stack.
BRIGHTDATA_TOKEN=
# Scraping Browser WebSocket endpoint (Puppeteer over wss — drives a remote
# headless Chrome for JS-rendered page fetches).
BRIGHTDATA_SBR_WSS=
# BrightData Selenium endpoint (alternative to the wss Scraping Browser).
BRIGHTDATA_SELENIUM=
# BrightData SERP API zone name (NOT configured for this account — leave
# empty; the engine falls back to DuckDuckGo HTML for live-web results).
BRIGHTDATA_SERP_ZONE=serp
# BrightData Web Unlocker zone name (legacy — kept for backward compat).
BRIGHTDATA_UNLOCKER_ZONE=web_unlocker
# BrightData datasets v3 zone name. Used by /api/brightdata/datasets.
BRIGHTDATA_DATASET_ZONE=cirkle_datasets
# Hard daily cap on BrightData calls (Scraping Browser + datasets combined).
# When this is hit, the engine silently falls back to the free stack.
BRIGHTDATA_DAILY_CAP=5
# Hard monthly cap on BrightData calls (zero-cost guarantee — cannot exceed).
BRIGHTDATA_MONTHLY_CAP=25
# Minutes to disable a BrightData kind (serp/unlocker/dataset) after a 401/403
# response. Prevents hammering a failing endpoint.
BRIGHTDATA_DISABLE_MINUTES=60
# Operator bearer token for the BrightData API endpoints (scrape / snapshot /
# datasets). If UNSET, all BrightData endpoints return 403 (secure default).
# Generate with: openssl rand -hex 32
BRIGHTDATA_OPERATOR_TOKEN=
# Path to the budget-counter persistence file (JSON). Defaults to the OS
# tmpdir. Use a persistent path in serverless deploys where /tmp is ephemeral.
BRIGHTDATA_BUDGET_FILE=

# --- Trusted proxy (optional — for rate-limit IP extraction) ----------------
# Comma-separated CIDRs trusted to set the `x-forwarded-for` header.
# If unset (default), x-forwarded-for is NOT trusted — the rate limiter
# uses the direct connection IP. Set this ONLY if you're behind a known
# proxy (e.g., Vercel edge: TRUSTED_PROXY_CIDR=198.51.100.0/24).
TRUSTED_PROXY_CIDR=

# --- Optional integrations ---------------------------------------------------
# Neon Postgres connection URL (alternative to DATABASE_URL — serverless
# Postgres with branching).
NEON_DATABASE_URL=
# Inngest signing key for background-job orchestration (cron reindex, etc.).
INNGEST_SIGNING_KEY=
# Public-facing app name (exposed to the client-side bundle). Override in
# production deployments to brand the search UI.
NEXT_PUBLIC_APP_NAME=CIRKLE Search
