# ═══════════════════════════════════════════════════════════════════════════
# Cirkle Mail — environment variables
# Copy this file to `.env` for local dev. Production env vars are auto-set
# by the Vercel-Neon integration. See DEPLOY.md for the full architecture.
# ═══════════════════════════════════════════════════════════════════════════

# ── PRIMARY DATABASE (Neon PostgreSQL) — Prisma postgresql provider ─────
# Local dev: set this to your Neon connection string (a dev branch is ideal).
# Production (Vercel): the Neon integration auto-sets DATABASE_URL — no manual config.
DATABASE_URL="postgresql://user:password@host:5432/neondb?sslmode=require"

# ── ANALYTICS (Neon direct connection) — for /api/analytics ──────────────
# When set, /api/analytics runs native Postgres aggregations via
# @neondatabase/serverless (COUNT FILTER, date_trunc, generate_series).
# Falls back to Prisma otherwise (same response shape, slower).
# On Vercel, set this to the same Neon URL (or leave unset to use Prisma).
NEON_DATABASE_URL=""

# ── Turso (libSQL) — backup/mirror database ─────────────────────────────
# Optional. Seeded via scripts/seed-turso.ts. Available as a future
# edge-read cache. Not used by the runtime app currently (Neon is primary).
TURSO_DATABASE_URL=""
TURSO_TOKEN=""

# ── Inngest — server-side background jobs ───────────────────────────────
# The /api/inngest route serves the deliverScheduledEmails cron function.
# Register the endpoint with Inngest Cloud: https://<your-domain>/api/inngest
INNGEST_API_KEY=""
INNGEST_SIGN_KEY=""

# ── Vercel Cron — backup scheduled-email delivery ───────────────────────
# Set a random secret (openssl rand -hex 32). Vercel Cron sends this as
# Authorization: Bearer <CRON_SECRET> when it hits /api/cron/deliver.
CRON_SECRET=""

# ── Multi-Model AI Consensus (optional — z-ai SDK is the built-in fallback) ──
OPENROUTER_API_KEY=""
GROQ_API_KEY=""
GEMINI_API_KEY=""
NVIDIA_API_KEY=""
HF_API_KEY=""
