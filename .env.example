# ═══════════════════════════════════════════════════════════════════════════
# Cirkle Mail — environment variables
# Copy this file to `.env` for local dev, and set the same vars on Vercel
# (Project → Settings → Environment Variables) for production.
# See DEPLOY.md for the full architecture.
# ═══════════════════════════════════════════════════════════════════════════

# ── PRIMARY DATABASE (Turso libSQL) — Prisma sqlite provider ───────────────
# Local dev:  a file-based SQLite database.
DATABASE_URL="file:/home/z/my-project/db/custom.db"
# Production (Vercel): set DATABASE_URL to your Turso libsql:// URL and set
# TURSO_TOKEN to the Turso access token.
#   DATABASE_URL="libsql://<your-db>.<org>.turso.io"
#   TURSO_TOKEN="<turso-access-token>"
TURSO_TOKEN=""

# ── ANALYTICS DATABASE (Neon PostgreSQL) — optional, for /api/analytics ──
# When set, /api/analytics runs heavy aggregations on Neon Postgres (better
# query planner for GROUP BY / window functions). When unset, falls back to
# the Prisma/Turso in-JS computation (same response shape, slower).
# Create a Neon project at https://neon.tech and paste the connection string.
NEON_DATABASE_URL=""

# ── Inngest — server-side background jobs ────────────────────────────────
# The /api/inngest route serves the `deliverScheduledEmails` cron function.
# Register the endpoint with Inngest Cloud: https://api.cirkle.mail/api/inngest
# (or your Vercel URL). Set these when you create an Inngest Cloud account.
INNGEST_API_KEY=""
INNGEST_SIGN_KEY=""

# ── Vercel Cron — backup scheduled-email delivery ────────────────────────
# Set a random secret (e.g. `openssl rand -hex 32`). Vercel Cron sends this
# as `Authorization: Bearer <CRON_SECRET>` when it hits /api/cron/deliver.
# If unset, the endpoint is open but idempotent (harmless if hit by anyone).
CRON_SECRET=""

# ── Multi-Model AI Consensus (optional — z-ai SDK is the built-in fallback) ──
# Set these to enable the consensus layer (majority-vote classification +
# best-confidence generation). Without them, the z-ai SDK handles everything.
OPENROUTER_API_KEY=""
GROQ_API_KEY=""
GEMINI_API_KEY=""
NVIDIA_API_KEY=""
HF_API_KEY=""
