# Prisma database URL. Cirkle Mail uses PostgreSQL in production (Vercel + Neon).
# Copy this file to `.env` and set a real connection string.
#
# Local dev: point this at your own Postgres instance or a Neon branch.
# (The committed schema uses provider = "postgresql".)
DATABASE_URL="postgresql://user:password@host:5432/cirkle?sslmode=require"

# ── Multi-Model AI Consensus (optional — the z-ai SDK is the built-in fallback) ──
# Set these to enable the consensus layer (majority-vote classification +
# best-confidence generation). Without them, the z-ai SDK handles everything.
OPENROUTER_API_KEY=""
GROQ_API_KEY=""
GEMINI_API_KEY=""
NVIDIA_API_KEY=""
HF_API_KEY=""
