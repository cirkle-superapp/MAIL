# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# P2-5: explicitly track the .env.example template so new contributors
# have a documented starting point. The actual .env with real secrets
# remains gitignored by the .env* pattern above.
!.env.example

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/.env
.env.local

# --- Hardening (Task 81) — transient runtime + agent artifacts ---

# Tool result scratch files (transient agent working files — not source code)
/tool-results/

# Dev server PID tracking (changes on every restart — not source)
/.zscripts/
/.zscripts/dev.pid

# BrightData budget file (transient runtime state — kept in /tmp by default,
# but if BRIGHTDATA_BUDGET_FILE is set to a project-local path, ignore it)
cirkle-brightdata-budget.json
*.tmp.brightdata-budget.json
